body{
	margin: 0;
	padding: 0;
	height: 100%;
	/*overflow: hidden;*/
	overflow: auto;

	display: flex;
	justify-content: center;
	align-items: center;
	background: #fff;
}

.bgscreen{
	margin-top: 0px;

	display: flex;
	justify-content: center;
	align-items: center;
	min-height: 100dvh;
	background: #fff;
}

.wrapper{
	display: flex;
	justify-content: center;
	/*align-items: center;*/
	align-items: flex-start;
	transform: translate(0, 10%);

	height: 110vh;
}

.form-box {
  max-width: 320px;
  /*background: #f1f7ff;*/
  background: #e9efff;
  overflow: hidden;
  color: #010101;
  border: 1px solid #aaa;
  border-radius: 16px;
  box-shadow: 7px 7px 39px rgba(30, 30, 30, 0.25);
  
}

.form {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 32px 24px;
  gap: 16px;
  text-align: center;  
}

.title {
  font-weight: bold;
  font-size: 2rem;
}

.form-container {
  overflow: hidden;
  border-radius: 8px;
  background-color: #fff;
  margin: 1rem 0 .5rem;
  width: 100%;
}

.input {
  background: none;
  border: 0;
  outline: 0;
  height: 40px;
  width: 100%;
  border-bottom: 1px solid #eee;
  font-size: 1.2rem;
  padding: 8px 15px;
}

.form-section {
  padding: 16px 20px;
  font-size: 1rem;
  /*background-color: #e0ecfb;*/
  background-color: #d0dcff;
  box-shadow: rgb(0 0 0 / 8%) 0 -1px;
  text-align: center;
  color: #888888;
  border-radius: 0px 0px 16px 16px;
  /*white-space: pre;*/
}
.form-section a {
  font-weight: bold;
  /*color: #0066ff;*/
  color: #888888;
  transition: color .3s ease;
}
.form-section a:hover {
  color: #005ce6;
  text-decoration: underline;
}

.form button {
  background-color: #0066ff;
  color: #fff;
  border: 0;
  border-radius: 24px;
  padding: 10px 16px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: background-color .3s ease;
}
.form button:hover {
  background-color: #005ce6;
}

.connection_info{
	font-size: 0.8em;
	border-radius: 5px;
	border: 1px solid #888888;
	padding: 10px 0px;
	color: #666666;
}
.connection_info input{
	font-size: 1em;
	width: 40%;
	padding-left: 10px;
	/*border: 0;*/
	/*border: 1px solid red;*/
}

