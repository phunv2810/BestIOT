* {
	box-sizing: border-box;
	margin: 0;
	padding: 0;
	-webkit-tap-highlight-color: transparent;
}

body {
	min-height: 100vh;
	margin: 0;
	padding: 24px 16px;
	background-color: #f6f8fb;
	font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
	display: flex;
	justify-content: center;
	align-items: center;
	color: #1a2638;
	line-height: 1.5;
}

.bgscreen {
	width: 100%;
	display: flex;
	justify-content: center;
	align-items: center;
}

.wrapper {
	width: 100%;
	max-width: 388px;
	display: flex;
	justify-content: center;
}

/* Main Card Container */
.form-box {
	width: 100%;
	background: #ffffff;
	border-radius: 12px;
	box-shadow: 0 10px 30px -4px rgba(0, 0, 0, 0.08), 0 4px 12px -2px rgba(0, 0, 0, 0.03);
	border: 1px solid #e8ecf2;
	overflow: hidden;
	display: flex;
	flex-direction: column;
}

/* 1. Top Crimson Header */
.card-header {
	background-color: #a01b24;
	padding: 26px 20px;
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 12px;
}

.header-logo {
	display: block;
	width: 42px;
	height: 32px;
	flex-shrink: 0;
}

.header-title {
	color: #ffffff;
	font-size: 23px;
	font-weight: 700;
	letter-spacing: -0.4px;
	white-space: nowrap;
}

/* 2. Main Form Body */
.form {
	padding: 30px 28px 24px 28px;
	display: flex;
	flex-direction: column;
	background: #ffffff;
}

.form-group {
	display: flex;
	flex-direction: column;
	margin-bottom: 18px;
}

.form-label {
	font-size: 15px;
	font-weight: 700;
	color: #1a2638;
	margin-bottom: 8px;
	text-align: left;
}

.input-container {
	position: relative;
	display: flex;
	align-items: center;
	background-color: #ffffff;
	border: 1.5px solid #d4dbe4;
	border-radius: 6px;
	height: 44px;
	padding: 0 14px;
	transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.input-container:focus-within {
	border-color: #137447;
	box-shadow: 0 0 0 3px rgba(19, 116, 71, 0.12);
}

.input-icon {
	display: flex;
	align-items: center;
	justify-content: center;
	color: #707e94;
	margin-right: 12px;
	flex-shrink: 0;
}

.input-field {
	flex: 1;
	height: 100%;
	border: none;
	outline: none;
	background: transparent;
	font-size: 14.5px;
	color: #1a2638;
	font-family: inherit;
}

.input-field::placeholder {
	color: #8f9cae;
	font-size: 14.5px;
}

.toggle-pw-btn {
	background: none;
	border: none;
	cursor: pointer;
	padding: 4px;
	color: #707e94;
	display: flex;
	align-items: center;
	justify-content: center;
	outline: none;
	transition: color 0.15s ease;
	margin-left: 8px;
}

.toggle-pw-btn:hover {
	color: #3b4758;
}

/* Remember ID Checkbox */
.remember-row {
	display: flex;
	align-items: center;
	margin-top: -2px;
	margin-bottom: 20px;
}

.checkbox-label {
	display: inline-flex;
	align-items: center;
	cursor: pointer;
	font-size: 14px;
	font-weight: 500;
	color: #2b3648;
	user-select: none;
	gap: 10px;
}

.checkbox-label input[type="checkbox"] {
	width: 17px;
	height: 17px;
	border-radius: 4px;
	border: 1.5px solid #a4b3c6;
	accent-color: #137447;
	cursor: pointer;
}

/* Login Button */
.btn-login {
	width: 100%;
	height: 46px;
	background-color: #137447;
	color: #ffffff;
	border: none;
	border-radius: 6px;
	font-size: 16px;
	font-weight: 600;
	cursor: pointer;
	display: flex;
	align-items: center;
	justify-content: center;
	transition: background-color 0.2s ease, transform 0.1s ease;
	box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
	margin-bottom: 22px;
	outline: none;
}

.btn-login:hover {
	background-color: #0f5f3a;
}

.btn-login:active {
	background-color: #0c4d2f;
	transform: scale(0.99);
}

/* Connection Info Box */
.connection_info {
	background-color: #f2f4f8;
	border: 1px solid #d4dbe4;
	border-radius: 6px;
	padding: 14px 18px 12px 18px;
	display: flex;
	flex-direction: column;
	gap: 8px;
}

.info-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.info-label {
	font-size: 14px;
	font-weight: 500;
	color: #2b3648;
}

.info-input {
	width: 135px;
	height: 26px;
	background-color: #e5eaf2;
	border: 1px solid #c9d3e0;
	border-radius: 4px;
	padding: 2px 8px;
	font-size: 13px;
	color: #2c3e50;
	outline: none;
	cursor: default;
	font-family: inherit;
	font-weight: 500;
	text-align: left;
}

.info-warning {
	margin-top: 6px;
	text-align: center;
	color: #1b62d8;
	font-size: 13.5px;
	font-weight: 600;
}

/* 3. Footer Section */
.form-section {
	background-color: #f2f4f8;
	border-top: 1px solid #e7ebf2;
	padding: 20px 20px;
	text-align: center;
	font-size: 14px;
	color: #4b586d;
}

.form-section p {
	margin: 0;
}

.signup-link {
	color: #137447;
	font-weight: 700;
	text-decoration: underline;
	margin-left: 6px;
	transition: color 0.15s ease;
}

.signup-link:hover {
	color: #0f5f3a;
}

/* Responsive adjustments */
@media (max-width: 440px) {
	body {
		padding: 12px;
	}
	
	.form {
		padding: 24px 20px 20px 20px;
	}

	.card-header {
		padding: 20px 16px;
	}

	.header-title {
		font-size: 21px;
	}

	.info-input {
		width: 120px;
	}
}